{
  "name": "tachyon-drive",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "npm run android:standalone",
    "android:standalone": "TACHYON_STANDALONE=1 expo run:android --variant release",
    "android:dev": "expo run:android",
    "web": "expo start --web",
    "assets": "python3 scripts/prepare_assets.py",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/*.test.cjs",
    "test": "npm run test:core && tsx --test tests/*.test.ts",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "^58.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.56.0"
  }
}
